# 008_Experiment research-snapshot policy
#
# This repository prioritizes source code, data-processing logic, compact
# generation configurations, and supporting documents.  Raw inputs, CSV
# datasets/results, and local run records stay on the local machine or in a
# separately managed data snapshot.

# ---------------------------------------------------------------------------
# Local CSV data, experiment results, and run records
# ---------------------------------------------------------------------------
# Exclude coordinate pools, user/UAV instances, result tables, and summaries.
# Also exclude compressed CSVs and backups such as *.csv.before_fix.bak.
# Existing tracked files are unaffected; these rules do not remove local data.
*.csv
*.csv.*

# Resume metadata belongs with the local result CSVs.  Keep source code,
# def_config.json, generation_config_ToN.json, and README files trackable.
/ExperimentsData/ExperimentsResults/**/run_info.json

# ---------------------------------------------------------------------------
# Population-processing data assets
# ---------------------------------------------------------------------------
# Keep the directory guide, but do not commit any raw, intermediate, or
# demonstration data below DatasetTest/data/.
/ExperimentsData/DatasetTest/data/**
!/ExperimentsData/DatasetTest/data/README.md

# Main experiment instances and archives are deliberately excluded.  JSON
# generation-condition files and the directory guide remain versioned.
/ExperimentsData/data/**/*.csv
/ExperimentsData/data_ToN/**/*.csv
/ExperimentsData/data/**/*.zip
/ExperimentsData/data/County_loc_Type_req/simulated_data/*.png

# ---------------------------------------------------------------------------
# Disconnected local DRL prototype
# ---------------------------------------------------------------------------
# The current C++ six-method conference-experiment loop does not invoke this
# Python DQN/DRL prototype.  It includes local training assets and checkpoints
# and is retained on the machine outside this synchronization snapshot.
/Algorithms/baselineAlgorithms/DRL_Algorithm_3/

# ---------------------------------------------------------------------------
# Machine-local build products and IDE state
# ---------------------------------------------------------------------------
**/.vs/
**/x64/
**/Debug/
**/Release/
*.obj
*.pdb
*.idb
*.ilk
*.tlog
*.exe
*.dll
*.iobj
*.ipdb
*.recipe
*.lastbuildstate
*.VC.db
*.opensdf
*.sdf
*.vsidx
*.suo
*.vcxproj.user

# ---------------------------------------------------------------------------
# Python and notebook caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Local secrets and operating-system metadata
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
Thumbs.db
Desktop.ini


/ExperimentsData/ExperimentsResults/ToN_routeA_v1_eps0p1/batch_20260905_n10_01/
