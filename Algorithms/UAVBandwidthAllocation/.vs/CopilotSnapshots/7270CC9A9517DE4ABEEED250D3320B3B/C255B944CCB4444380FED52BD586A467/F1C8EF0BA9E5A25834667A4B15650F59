		}
	}
}





map<double, KnapsackResult> BAProblem::RP_based_subproblem_allocation(int uav_id, double epsilon)
{
    map<double, KnapsackResult> result_list;
    double max_utility_ratio = 1; // 效用最大时，对应的连续部分比例

    double ratio_step = 0.01;        // 每次增加的比例
    double continuous_ratio = 1; // 连续部分比例

    while(continuous_ratio >= 0)
    {
        double discrete_ratio = 1 - continuous_ratio;
        uavs[uav_id].soft_bandwidth = uavs[uav_id].total_bandwidth * continuous_ratio;
        uavs[uav_id].hard_bandwidth = uavs[uav_id].total_bandwidth * discrete_ratio;

        // 1. 离散部分：0-1背包问题
        vector<double> weights;
        vector<double> values;
        vector<int> idx_map; // mapping from filtered index -> original user id
        for (int j = 0; j < n1; j++)
        {
            // skip users with zero channel capacity
            if (cap_list[uav_id][j] == 0)
                continue;
            User& u = users[j];
            weights.push_back(u.rMin / cap_list[uav_id][j]); // 物品的重量：用户j的最小速率需求转换为带宽需求
            values.push_back(u.weight * 1.0); // 物品的价值：用户j的权重
            idx_map.push_back(j);
        }

        KnapsackResult discrete_filtered = FPTAS_0_1_knapsack(weights, values, uavs[uav_id].hard_bandwidth, epsilon);
        // remap filtered result back to original user ids
        KnapsackResult discrete_result;
        discrete_result.totalWeight = discrete_filtered.totalWeight;
        discrete_result.totalValue = discrete_filtered.totalValue;
        for (auto &p : discrete_filtered.allocatedList) {
            int filtered_idx = p.first;
            double w = p.second;
            if (filtered_idx >= 0 && filtered_idx < (int)idx_map.size()) {
                int orig_id = idx_map[filtered_idx];
                discrete_result.allocatedList.insert({ orig_id, w });
            }
        }

        double remain_resource = uavs[uav_id].hard_bandwidth - discrete_result.totalWeight;
        uavs[uav_id].soft_bandwidth += remain_resource;

        // 2. 连续部分：KKT条件
        KnapsackResult continuous_result = KKT_based_elastic_utility(uav_id);
        // 3. 合并结果
        KnapsackResult current_result;
        current_result.softValue = continuous_result.totalValue;
        current_result.hardValue = discrete_result.totalValue;
        current_result.softWeight = continuous_result.totalWeight;
        current_result.hardWeight = discrete_result.totalWeight;

        current_result.totalWeight = discrete_result.totalWeight + continuous_result.totalWeight;
        current_result.totalValue = discrete_result.totalValue + continuous_result.totalValue;
        current_result.allocatedList = discrete_result.allocatedList;

        for (auto item : continuous_result.allocatedList)
        {
            current_result.allocatedList.insert(item);
        }

        result_list.insert({ continuous_ratio, current_result });

        if( current_result.totalValue > result_list[max_utility_ratio].totalValue)
            max_utility_ratio = continuous_ratio;

        continuous_ratio -= ratio_step;
    }

    return result_list;
}

/*
* 函数功能：基于资源分割的子问题求解
* @param uav_id：当前求解的UAV的ID
* @param delta：每次减少的硬资源量
* @param epsilon：FPTAS算法的误差参数
* returns：不同硬资源量下的分配结果
* 备注：该函数通过遍历不同的硬资源量，分别求解离散部分和连续部分的分配问题，
* 并将结果合并，最终返回不同硬资源量下的分配结果。
*/
map<double, KnapsackResult> BAProblem::RP_based_subproblem_allocation2(int uav_id, double delta, double epsilon)
{
    map<double, KnapsackResult> result_list;
    double hard_bandwidth = uavs[uav_id].total_bandwidth; // 初始化
    double max_utility_bandwidth = hard_bandwidth; // 效用最大时，对应的硬资源量
    int count = 0;     // 计数器，防止死循环

    while (hard_bandwidth > 0)
    {
        uavs[uav_id].hard_bandwidth = hard_bandwidth;
        uavs[uav_id].soft_bandwidth = uavs[uav_id].total_bandwidth - hard_bandwidth;

        // 1. 离散部分：0-1背包问题
        vector<double> weights;
        vector<double> values;
        vector<int> idx_map; // mapping
        for (int j = 0; j < n1; j++)
        {
            if(cap_list[uav_id][j] == 0)
                continue; // 避免除以0并且跳过无法分配的用户
            User& u = users[j];
            weights.push_back(u.rMin / cap_list[uav_id][j]); // 物品的重量：用户j的最小速率需求转换为带宽需求
            values.push_back(u.weight * 1.0); // 物品的价值：用户j的权重
            idx_map.push_back(j);
        }
        KnapsackResult discrete_filtered = FPTAS_0_1_knapsack(weights, values, uavs[uav_id].hard_bandwidth, epsilon);
        // remap
        KnapsackResult discrete_result;
        discrete_result.totalWeight = discrete_filtered.totalWeight;
        discrete_result.totalValue = discrete_filtered.totalValue;
        for (auto &p : discrete_filtered.allocatedList) {
            int filtered_idx = p.first;
            double w = p.second;
            if (filtered_idx >= 0 && filtered_idx < (int)idx_map.size()) {
                int orig_id = idx_map[filtered_idx];
                discrete_result.allocatedList.insert({ orig_id, w });
            }
        }

        // 离散部分剩余的资源分配给连续部分
        double remain_resource = uavs[uav_id].hard_bandwidth - discrete_result.totalWeight;
        uavs[uav_id].soft_bandwidth += remain_resource;

        // 2. 连续部分：KKT条件
        KnapsackResult continuous_result = KKT_based_elastic_utility(uav_id);

        // 3. 合并结果
        KnapsackResult current_result;
        current_result.softValue = continuous_result.totalValue;
        current_result.hardValue = discrete_result.totalValue;
        current_result.softWeight = continuous_result.totalWeight;
        current_result.hardWeight = discrete_result.totalWeight;

        current_result.totalWeight = discrete_result.totalWeight + continuous_result.totalWeight;
        current_result.totalValue = discrete_result.totalValue + continuous_result.totalValue;
        current_result.allocatedList = discrete_result.allocatedList;

        for (auto item : continuous_result.allocatedList)
        {
            current_result.allocatedList.insert(item);
        }

        result_list.insert({ hard_bandwidth, current_result });

        if (current_result.totalValue > result_list[max_utility_bandwidth].totalValue)
            max_utility_bandwidth = hard_bandwidth;



        // 更新hard_bandwidth
        hard_bandwidth = discrete_result.totalWeight - delta;
        count++;
    }

    return result_list;
}

KnapsackResult BAProblem::FPTAS_0_1_knapsack(vector<double>& weights, vector<double>& values, double capacity, double epsilon)
{
    // 参考文献：A Fast Polynomial-Time Approximation Scheme for the 0-1 Knapsack Problem
    // 该算法是一个针对0-1背包问题的快速多项式时间近似方案
    // 输入：物品的价值和重量，背包的容量，误差参数ε
    // 输出：近似最优解
    // 获取当前UAV对应的用户列表
    int n = weights.size();
    KnapsackResult result;
    if (n == 0 || capacity <= 0) return result;

    // 1. 计算缩放因子K
	int v_max = *max_element(values.begin(), values.end());
    double K = max(1.0, (epsilon * v_max) / n); // 避免K=0

    // 2. 缩放价值并计算新价值总和
    vector<int> scaled_values(n);
    int scaled_V = 0;
    for (int i = 0; i < n; i++) {
        scaled_values[i] = (int)floor(values[i] / K);
        scaled_V += scaled_values[i];
    }

    if (scaled_V == 0) {
        // 所有物品缩放价值为0，无法通过DP区分，返回空结果
        return result;
    }

    // 3. 动态规划求解：dp[v] = 达到价值v的最小重量（使用double避免截断误差）
    constexpr double INF = std::numeric_limits<double>::infinity();
    vector<double> dp(scaled_V + 1, INF);
    // selected[i][v] 表示在处理到第 i 件物品时，是否选择第 i 件以达到价值 v
    vector<vector<char>> selected(n, vector<char>(scaled_V + 1, 0));
    dp[0] = 0.0;

    // 填充DP表并记录选择决策
    for (int i = 0; i < n; i++) {
        int sv = scaled_values[i];
        if (sv <= 0) continue; // 缩放价值为0的物品对DP无影响，可跳过
        // 遍历时从高到低，保证每件物品只使用一次
        for (int v = scaled_V; v >= sv; v--) {
            if (dp[v - sv] != INF) {
                double new_weight = dp[v - sv] + weights[i];
                // 仅当新的重量在容量范围内并且更优时更新
                if (new_weight <= capacity && new_weight < dp[v]) {
                    dp[v] = new_weight;
                    selected[i][v] = 1; // 标记选择当前物品
                }
            }
        }
    }

    // 4. 找到缩放价值最大的有效解
    int max_scaled_value = 0;
    for (int v = scaled_V; v >= 0; v--) {
        if (dp[v] <= capacity) {
            max_scaled_value = v;
            break;
        }
    }

    // 5. 回溯找出选择的物品
    int current_value = max_scaled_value;
    for (int i = n - 1; i >= 0 && current_value > 0; i--) {
        int sv = scaled_values[i];
        if (sv <= 0) continue;
        if (current_value >= sv && selected[i][current_value]) {
            result.allocatedList.insert({ i, weights[i] });
            result.totalWeight += weights[i];
            result.totalValue += values[i];
            current_value -= sv;
        }
    }

    // 最后做一次安全检查，确保总重量不超过容量
    if (result.totalWeight > capacity + 1e-9) {
        // 如果由于数值误差超过了容量，则移除一些物品直到符合容量限制
        // 以最小价值密度优先移除（value/weight 最小）
        vector<pair<int, double>> items;
        for (auto &p : result.allocatedList) {
            int idx = p.first;
            double w = p.second;
            double density = (values[idx] / (w > 0 ? w : 1e-12));
            items.push_back({ idx, density });
        }
        // 按密度升序移除低密度物品（对总价值影响最小）
        sort(items.begin(), items.end(), [](const pair<int,double>& a, const pair<int,double>& b){ return a.second < b.second; });
        for (auto &it : items) {
            if (result.totalWeight <= capacity + 1e-9) break;
            int idx = it.first;
            // remove
            result.totalWeight -= weights[idx];
            result.totalValue -= values[idx];
            result.allocatedList.erase(idx);
        }
    }

    return result;
}

KnapsackResult BAProblem::KKT_based_elastic_utility(int uav_id)
{
	// 根据obsidian笔记"000-工作日志-讨论日志-9月 对于连续部分：KKT条件找最优解"
	// 当中推导出了最优拉格朗日乘子λ的表达式
	double lambda = 0.0;
	double sum_S = 0;
	double sum_C = 0;

	if(uavs[uav_id].soft_bandwidth <= 0)
	{
		KnapsackResult empty_result;
		return empty_result;
	}

	map<int, double> allocated_users; // 记录被分配带宽的{用户ID, 带宽}
	// 初始化allocated_users，假设所有用户都被分配带宽
	for (int j = n1; j < n1 + n2; j++)
	{
		if(cap_list[uav_id][j] == 0)
			continue; // 避免除以0
		allocated_users.insert({ j, 0 });
	}

	int is_alloc = 0;	// 标记是否完成分配
	while (!is_alloc)
	{
		for (auto entry : allocated_users)
		{
			int j = entry.first;
			User& u = users[j];
			sum_S += u.weight / log(u.rMin + 1);
			sum_C += 1 / cap_list[uav_id][j];
		}

		lambda = sum_S / (uavs[uav_id].soft_bandwidth + sum_C);

		// 记录最小的带宽值，初始化为无穷大
		double min_bandwidth = numeric_limits<double>::max();
		int min_user = -1; // 记录最小带宽对应的用户ID

		for (auto entry : allocated_users)
		{
			int j = entry.first;
			User& u = users[j];
			double Sij = u.weight / log(u.rMin + 1);
			double Cij = 1 / cap_list[uav_id][j];
			double bandwidth_ij = (Sij / lambda - Cij);
			if (bandwidth_ij < min_bandwidth)
			{
				min_bandwidth = bandwidth_ij;
				min_user = j;
			}
			allocated_users[j] = bandwidth_ij;
			//cout << "j = " << j << "\tSij = " << Sij << "\tSij/lambda = " << Sij / lambda << "\tCij = " << Cij << "\tbandwidth_ij = " << bandwidth_ij << '\n';
		}

		if(min_bandwidth < 0)
		{
			// 将该用户从allocated_users中移除
			allocated_users.erase(min_user);
			// 重新计算sum_S和sum_C
			sum_S = 0;
			sum_C = 0;
			//cout << "User " << min_user << " removed from allocation due to negative bandwidth." << '\n';
		}
		else
		{
			is_alloc = 1; // 分配完成
		}
	}



	// 根据λ的值计算每个用户的分配带宽
	KnapsackResult alloc_result;
	for (auto entry : allocated_users)
	{
		int j = entry.first;
		double bandwidth_ij = entry.second;

		alloc_result.allocatedList.insert({ j, bandwidth_ij });
		alloc_result.totalWeight += bandwidth_ij;
		alloc_result.totalValue += users[j].elastic_utility(bandwidth_ij, cap_list[uav_id][j]);
		// cout << "Final allocation - User " << j << ": Bandwidth = " << bandwidth_ij << ", Utility = " << users[j].elastic_utility(bandwidth_ij, cap_list[uav_id][j]) << '\n';
	}
	
	
	return alloc_result;
}

KnapsackResult BAProblem::CPLEX_based_elastic_utility(int uav_id)
{
    // 尝试用 CPLEX 求解；若提取/求解失败则回退到 KKT 解析解（更稳健）
    KnapsackResult alloc_result;
    IloEnv env;
    try {
        IloModel model(env);
        // 构造变量（使用 n2 长度的变量数组），确保用同一个 env
        IloNumVarArray bij(env, n2, 0.0, IloInfinity, ILOFLOAT);

        // 约束：总带宽
        IloExpr constraint_expr(env);
        for (IloInt j = 0; j < n2; j++) constraint_expr += bij[j];
        model.add(constraint_expr <= uavs[uav_id].soft_bandwidth);
        constraint_expr.end();

		// 构造目标（注意：IloLog 是非线性，可能在某些 CPLEX 安装下无法提取）
		IloExpr objective_expr(env);
		for (IloInt j = n1; j < n1 + n2; j++) {
			User& u = users[j];
			double c_ij = cap_list[uav_id][j];
			objective_expr += (u.weight * IloLog(1 + bij[j - n1] * c_ij)) / log(1 + u.rMin);
		}
		model.add(IloMaximize(env, objective_expr));
		objective_expr.end();

        // 构造求解器（这里可能抛出“cannot extract extractables...”）
        IloCplex cplex(model);
        if (!cplex.solve()) {
            env.error() << "Failed to optimize (CPLEX returned no solution)." << std::endl;
            env.end();
            // 回退
            return alloc_result;
        }

        // 读取解
        for (int j = n1; j < n1 + n2; ++j) {
            double bandwidth_ij = cplex.getValue(bij[j - n1]);
            alloc_result.allocatedList.insert({ j, bandwidth_ij });
            alloc_result.totalWeight += bandwidth_ij;
            alloc_result.totalValue += users[j].elastic_utility(bandwidth_ij, cap_list[uav_id][j]);
        }
        env.end();
        return alloc_result;
    }
    catch (IloException& e) {
        std::cerr << "IloException: " << e.getMessage() << std::endl;
        // 清理 env 并回退到解析解
        env.end();
        return alloc_result;
    }
    catch (...) {
        std::cerr << "Unknown exception in CPLEX_based_elastic_utility" << std::endl;
        env.end();
        return alloc_result;
    }
}

