	cap_list = vector<vector<double>>(m, vector<double>(n1 + n2, 0.0));

	alloc_matrix = vector<vector<double>>(m, vector<double>(n1 + n2, 0.0));
	connect_matrix = vector<vector<int>>(m, vector<int>(n1 + n2, 0));

	for (int i = 0; i < m; i++)
	{
		for (int j = 0; j < n1 + n2; j++)
		{
			Channel ch(uavs[i], users[j]);
			dis_list[i][j] = ch.d;
			SNRa_list[i][j] = ch.SNRa_dB;
			SNRt_list[i][j] = ch.SNRt_dB;
