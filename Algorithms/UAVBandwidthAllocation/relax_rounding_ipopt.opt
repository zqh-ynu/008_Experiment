# 该文件是求解器IPOPT的配置文件
# hessian_approximation limited-memory  # <-- 注释掉或删除这一行！

# 其他参数
tol 1e-6
mu_strategy adaptive
print_level 0
max_iter 1000
sb yes
# Route A: solve the original bounds, with feasibility tighter than the public result contract.
bound_relax_factor 0
constr_viol_tol 1e-10
acceptable_constr_viol_tol 1e-10
